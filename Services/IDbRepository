
﻿using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
namespace MESSerialNumberAPI.Services
{
    public interface IDbRepository<T> where T : class
    {
        IQueryable<T> GetAll();
        void Add(T entity);
        void AddRange(IEnumerable<T> entities, int batchSize);
        void Update(T entity);
        void UpdateRange(IEnumerable<T> entities, int batchSize);
        void Delete(int id);
        void SaveChanges();
    }
}
