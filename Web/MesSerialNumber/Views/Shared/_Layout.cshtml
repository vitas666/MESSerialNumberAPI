@using WebTemplate.Constant;
@using Giant.opItem;
@using Giant.ACC2;
@using System.Configuration;
@using WebTemplate.Helper;
@{
    OperationTicket operationTicket = (OperationTicket)this.Session[CommonConstant.SESSION_USER];
    OpItem pages = (OpItem)this.Session[CommonConstant.SESSION_PAGES];

    // 取得目前連線的網址
    Uri MyUrl = Request.Url;
    string FullUrl = Request.Url.AbsoluteUri.Substring(0, Request.Url.AbsoluteUri.LastIndexOf(Request.Url.AbsolutePath)) + Request.ApplicationPath;
    if (FullUrl.Substring(FullUrl.Length - 1, 1) != "/")
    {
        FullUrl = FullUrl + "/";
    }
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
    <title>@ViewBag.Title</title>
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/jquery-ui.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/sun_TableEditMain.css")" rel="stylesheet" type="text/css" />
    @RenderSection("styles", false)
    @*
        不用@Url.Content()的方式是為了在開發時能使用IntelliSense
    *@
    <script>
        var URL = '@FullUrl';
    </script>
    <script src="@Url.Content(string.Format("~/{0}/{1}", ConfigurationManager.AppSettings[CommonConstant.APP_SETTINGS_KEY_I18N_JS_FILE_PATH], this.ViewBag.I18nJSFileName))" type="text/javascript"></script>
    <script src="~/Scripts/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script src="~/Scripts/json2.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery-ui.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.cookie-1.4.1.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.form.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.dateFormat-1.0.js" type="text/javascript"></script>
    <script src="~/Scripts/sunUtilTableEdit.js" type="text/javascript"></script>
    <script src="~/Scripts/sunUtilLayout.js" type="text/javascript"></script>
    <script src="~/Scripts/sunUtilLayoutEditor.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery-helper.js" type="text/javascript"></script>
    <script src="~/Scripts/Shared/_Layout.js" type="text/javascript"></script>
    @RenderSection("scripts", false)
</head>
<body class="width-full">
    <!-- LOADING GRADIENT SPINNER -->
    <div class="loading-overlay display-none">
        <div class="spinner-box">
            <div class="circle-border">
                <div class="circle-core"></div>
            </div>
        </div>
    </div>

    @if (operationTicket != null)
    {
        <div class="banner-small">
        </div>
        <div class="tool-container">
            <div class="float-left tool-container-left">
                <div class="float-left">
                    <div id="ShowMenu" class="show-menu">
                    </div>
                    <div id="HideMenu" class="hide-menu">
                    </div>
                </div>
                <div>
                    <input id="showInNewTabCheckbox" type="checkbox" />
                    <label for="showInNewTabCheckbox">
                        <span id="ShowInNewTab"></span>
                    </label>
                </div>
            </div>
            <div class="float-right user">@operationTicket.TicketCaption</div>
            @if (MyUrl.Authority == ConfigurationManager.AppSettings[MesSerialNumber.Constant.Common.APP_SETTINGS_KEY_TEST_URL_AUTHORITY])
            {
                <div id="TestEnvironment" class="float-right user padding-top-2px" style="color: Red; font-size: 110%;">
                </div>
            }
        </div>
    }
    else
    {
        <div class="banner-login-container">
            <div class="banner-login">
            </div>
        </div>
    }
    @if (pages != null &&
                ((pages.ProgramPrivilege & OpProgramPrivilegeEnum.Execute) == OpProgramPrivilegeEnum.Execute))
    {
        <div>
            <div id="menu" class="float-left menu-container">
                @Html.Raw(ViewHelper.RenderMenuDIV(this, pages))
            </div>
            <div id="viewBody" class="float-left">
                <div id="Title" class="pageTitle">
                </div>
                <div>@RenderBody()</div>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }
    @*Re-Login要用到的Domain*@
    @Html.Raw(ViewHelper.RenderSupportedDomains(this, "reLoginDomain", " display:none;"))
    @RenderSection("footer", false)
    <script type="text/javascript">
        function generateActionUrl(controller, action) {
            return '@Url.Action("ACTION", "CONTROLLER")'.replace("ACTION", action).replace("CONTROLLER", controller);
        }
    </script>
</body>
</html>